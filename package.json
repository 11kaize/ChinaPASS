{
  "name": "chinahand-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "ChinaHand native mobile companion and legacy desktop demo",
  "productName": "ChinaHand",
  "desktopName": "chinahand",
  "main": "electron/main.cjs",
  "author": "ChinaHand contributors",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check:links": "node scripts/check-links.mjs",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder",
    "desktop:win": "electron-builder --win nsis",
    "desktop:mac": "electron-builder --mac dmg zip",
    "desktop:linux": "electron-builder --linux AppImage deb",
    "mobile": "node scripts/start-mobile.mjs",
    "demo": "node scripts/start-mobile.mjs --no-dev --minify",
    "mobile:check": "npm --prefix mobile run check",
    "mobile:apk": "npm --prefix mobile run build:apk",
    "demo:ios": "node scripts/start-mobile.mjs --preview",
    "demo:build": "node scripts/build-pages-demo.mjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  }
}
