  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --lan",
    "demo": "expo start --lan --no-dev --minify --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "sync-content": "node scripts/sync-content.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:native": "node scripts/prepare-motion-icons.mjs && expo export --platform android --platform ios && node scripts/copy-notices.mjs",
    "build:apk": "bash scripts/build-android.sh",
    "assets:prepare": "node scripts/prepare-artwork.mjs",
    "icons:prepare": "node scripts/prepare-motion-icons.mjs"
