{
  "expo": {
    "name": "ChinaHand",
    "slug": "chinahand",
    "version": "2.0.0",
    "scheme": "chinahand",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/brand.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.chinahand.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.chinahand.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand.png",
        "backgroundColor": "#165645"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand.png",
          "imageWidth": 96,
          "backgroundColor": "#F3F5F4",
          "dark": {
            "backgroundColor": "#101813"
          }
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand.png"
    }
  }
}
